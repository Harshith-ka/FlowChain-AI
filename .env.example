# FlowChain AI Environment Configuration

# Application
APP_ENV=development
APP_SECRET_KEY=flowchain-super-secure-production-secret-key-change-me-in-prod-32bytes
DEBUG=true

# Database (defaults to local SQLite for instant zero-dependency execution, or PostgreSQL)
DATABASE_URL=sqlite:///./flowchain.db
# For PostgreSQL: postgresql://flowchain:flowchain_secret@localhost:5432/flowchain_db

# Redis (for caching & Celery, fallback to in-memory)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# AI / LLM Configuration (Optional: fallback heuristic & structured solver logic available)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAPBOX_TOKEN=
